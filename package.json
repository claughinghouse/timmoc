{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "timmoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp check --fix && aube run lint",
    "check": "vp check && aube run lint",
    "test": "vp test run",
    "auth": "alchemy profile edit --add Cloudflare",
    "deploy": "alchemy deploy --stage production --adopt",
    "plan": "alchemy plan --stage production",
    "dev": "alchemy dev",
    "start": "alchemy dev"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "@effect/vitest": "4.0.5",
    "@types/node": "24.10.0",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "aube@2.8.1"
}
