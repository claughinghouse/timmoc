{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "timmoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp check --fix && aube run lint",
    "check": "vp check && aube run lint",
    "test": "vp test run",
    "auth": "alchemy profile edit --add Cloudflare",
    "deploy": "alchemy deploy --stage production --adopt",
    "plan": "alchemy plan --stage production",
    "dev": "alchemy dev",
    "start": "alchemy dev"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-node": "4.1.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "5.20261109.1",
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "aube@2.8.1"
}
